# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# JWT_SECRET: Secret key for signing JWT authentication tokens
JWT_SECRET="shopkart-super-secure-mern-secret-key-2026"

# MONGODB_URI: MongoDB Atlas connection string (optional - falls back to persistent storage if omitted)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/shopkart?retryWrites=true&w=majority
MONGODB_URI=""

# RAZORPAY_KEY_ID: Razorpay key for payments (optional - sandbox demo mode active when omitted)
RAZORPAY_KEY_ID=""

# RAZORPAY_KEY_SECRET: Razorpay webhook & verification secret
RAZORPAY_KEY_SECRET=""
